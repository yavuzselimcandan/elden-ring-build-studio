<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elden Ring Build Studio" Width="1400" Height="880" MinWidth="1120" MinHeight="700"
        Background="#0E0F12" Foreground="#E8E1D3" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#16181D"/>
    <SolidColorBrush x:Key="Panel2" Color="#1C1F26"/>
    <SolidColorBrush x:Key="Line" Color="#2A2E37"/>
    <SolidColorBrush x:Key="Muted" Color="#8C8676"/>
    <SolidColorBrush x:Key="Gold" Color="#C9A45C"/>
    <SolidColorBrush x:Key="GoldSoft" Color="#6E5A33"/>
    <FontFamily x:Key="Serif">Palatino Linotype, Georgia, Segoe UI</FontFamily>

    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,16"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E8E1D3"/>
      <Setter Property="Background" Value="#23262E"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#C9A45C"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#C9A45C"/>
      <Setter Property="Foreground" Value="#15110A"/>
      <Setter Property="BorderBrush" Value="#C9A45C"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C9A45C"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101216"/>
      <Setter Property="Foreground" Value="#E8E1D3"/>
      <Setter Property="CaretBrush" Value="#C9A45C"/>
      <Setter Property="SelectionBrush" Value="#6E5A33"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#C9A45C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#E8E1D3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="track" Width="38" Height="20" CornerRadius="10" Background="#2A2E37" VerticalAlignment="Center">
                <Ellipse x:Name="knob" Width="14" Height="14" Fill="#8C8676" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#6E5A33"/>
                <Setter TargetName="knob" Property="Fill" Value="#C9A45C"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#E8E1D3"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,7" Margin="0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1F222A"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#2A2518"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#B9B19F"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="11" Padding="10,3" Background="#1C1F26" BorderBrush="#2A2E37" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2A2518"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#C9A45C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="#343844" CornerRadius="4" Margin="1"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="360"/>
    </Grid.ColumnDefinitions>

    <!-- Preset library -->
    <Border Grid.Column="0" Background="#121317" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,22,14,16">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="BUILD STUDIO" FontFamily="{StaticResource Serif}" FontSize="22" Foreground="{StaticResource Gold}"/>
          <TextBlock Text="Elden Ring loadout forge" Style="{StaticResource Caption}" Margin="0,2,0,18"/>
          <TextBox Name="PresetFilter" Margin="0,0,0,10" ToolTip="Filter presets"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <WrapPanel>
            <Button Name="NewBtn" Content="New" Margin="0,0,6,6"/>
            <Button Name="PromptBtn" Content="Gemini prompt" Style="{StaticResource Primary}" Margin="0,0,6,6" ToolTip="Copy the build-extraction prompt for YouTube's Ask (Gemini) box"/>
            <Button Name="PasteBtn" Content="Paste build" Margin="0,0,6,6" ToolTip="Import the build text or JSON from the clipboard (also Ctrl+V, or automatically when you return to this window)"/>
            <Button Name="FolderBtn" Content="Folder" Margin="0,0,6,6"/>
          </WrapPanel>
        </StackPanel>
        <ListBox Name="PresetList" TextSearch.TextPath="Title">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="13.5"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="#8C8676" FontSize="11"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Build editor -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Padding="26,20,26,14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <StackPanel>
          <TextBox Name="BuildName" FontFamily="{StaticResource Serif}" FontSize="24" Background="Transparent" BorderBrush="Transparent" Padding="0" Foreground="#F1E9D8" ToolTip="Build name"/>
          <DockPanel Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Name="ConnChip" CornerRadius="12" Padding="10,4" Background="#1C1F26" Margin="0,0,14,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Name="ConnDot" Width="8" Height="8" Fill="#8C8676" VerticalAlignment="Center"/>
                  <TextBlock Name="ConnText" Text="Game offline" Margin="7,0,0,0" Foreground="#B9B19F" FontSize="12"/>
                </StackPanel>
              </Border>
              <ToggleButton Name="AutoApply" Content="Auto-apply" ToolTip="Apply automatically to the running offline game after each change"/>
              <Button Name="ApplyBtn" Content="Apply to game" Style="{StaticResource Primary}" Margin="0"/>
            </StackPanel>
            <TextBlock Name="SourceText" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Padding="26,8" Background="#121317" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <TextBlock Name="StatusText" Foreground="#B9B19F" Text="Ready."/>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,18,26,4">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock Name="LevelText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Top"/>
                <TextBlock Text="Attributes" Style="{StaticResource CardTitle}"/>
              </DockPanel>
              <UniformGrid Name="StatsGrid" Columns="4"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="Click a slot, then pick an item on the right" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Text="Equipment" Style="{StaticResource CardTitle}"/>
              </DockPanel>
              <StackPanel Name="EquipPanel"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="Granted, not equipped" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Text="Inventory" Style="{StaticResource CardTitle}"/>
              </DockPanel>
              <WrapPanel Name="InventoryPanel"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Inspector -->
    <Border Grid.Column="2" Background="#121317" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
      <Grid Margin="18,22,18,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Name="PickerTitle" Text="Add to inventory" FontFamily="{StaticResource Serif}" FontSize="17" Foreground="{StaticResource Gold}"/>
          <TextBlock Name="PickerSub" Text="Search 6,352 catalog items" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
          <TextBox Name="SearchBox" FontSize="14" Margin="0,0,0,10"/>
          <WrapPanel Name="CategoryChips">
            <RadioButton Style="{StaticResource Chip}" GroupName="cat" Tag="" Content="All" IsChecked="True"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="cat" Tag="weapon" Content="Weapons"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="cat" Tag="armor" Content="Armor"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="cat" Tag="talisman" Content="Talismans"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="cat" Tag="goods" Content="Spells &amp; goods"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="cat" Tag="ash" Content="Ashes"/>
          </WrapPanel>
        </StackPanel>
        <ListBox Name="Results" Grid.Row="1" Margin="0,4,0,8">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" Foreground="#6F6A5E" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding name}"/>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Name="SelectedName" Text="Nothing selected" FontSize="14" TextWrapping="Wrap"/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Name="UpgradeBox">
                <TextBlock Text="UPGRADE" Style="{StaticResource Caption}"/>
                <TextBox Name="UpgradeInput" Text="0" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="QUANTITY" Style="{StaticResource Caption}"/>
                <TextBox Name="QtyInput" Text="1" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
            <StackPanel Name="AshBox" Margin="0,8,0,0">
              <TextBlock Text="ASH OF WAR (optional)" Style="{StaticResource Caption}"/>
              <TextBox Name="AshInput" Margin="0,3,0,0"/>
            </StackPanel>
            <WrapPanel Margin="0,12,0,0">
              <Button Name="PlaceBtn" Content="Add" Style="{StaticResource Primary}"/>
              <Button Name="ClearSlotBtn" Content="Clear slot"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,12" Margin="0" MaxHeight="230">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Name="IssuesTitle" Text="Resolution" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Name="IssuesPanel"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
