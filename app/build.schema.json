{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offline-elden-ring-build-1.0.0",
  "title": "Offline Elden Ring Build",
  "type": "object",
  "required": ["schemaVersion", "name", "source", "items", "stats"],
  "properties": {"schemaVersion": {"const": "1.0.0"}, "name": {"type": "string"}, "source": {"type": "string"}, "gameVersion": {"type": "string"}, "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "stats": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 99}}, "unresolved": {"type": "array", "items": {"type": "string"}}},
  "$defs": {"item": {"type": "object", "required": ["category", "name"], "properties": {"category": {"enum": ["weapon", "armor", "talisman", "material", "spell", "other"]}, "name": {"type": "string"}, "upgrade": {"type": ["integer", "null"], "minimum": 0, "maximum": 25}, "quantity": {"type": "integer", "minimum": 1}, "confidence": {"enum": ["high", "medium", "low"]}}}}
}
